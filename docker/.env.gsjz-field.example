# GSJZ field override for an application-only RAGFlow deployment.
# Copy to .env.gsjz-field, chmod 600, and replace every CHANGE_ME value.
# Use together with docker/.env; do not replace the generic docker/.env file.

# Start only the CPU application profile. Existing base-* services are reused.
COMPOSE_PROFILES=cpu
DEVICE=cpu
RAGFLOW_IMAGE=ragflow:0.27.2-gsjz-CHANGE_ME
RAGFLOW_NETWORK_NAME=dev

# Established production host ports.
SVR_WEB_HTTP_PORT=280
SVR_STANDALONE_WEB_HTTP_PORT=281
SVR_WEB_HTTPS_PORT=2443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
GO_ADMIN_PORT=9383
GO_HTTP_PORT=9384

# Existing field MySQL service; use a dedicated clean RAGFlow database.
MYSQL_HOST=base-mysql5
MYSQL_PORT=3306
MYSQL_DBNAME=rag_flow_gsjz_0272
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME

# Existing field Elasticsearch service.
ES_HOST=base-elasticsearch
ES_PORT=9200
ES_USER=
ELASTIC_PASSWORD=CHANGE_ME

# Existing field MinIO service; use a dedicated bucket/prefix.
MINIO_HOST=base-minio
MINIO_PORT=9000
MINIO_USER=CHANGE_ME
MINIO_PASSWORD=CHANGE_ME
MINIO_BUCKET=ragflow-gsjz-0272
MINIO_PREFIX_PATH=gsjz-0272

# Existing field Redis service; use a dedicated logical DB.
REDIS_HOST=base-redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=2

# QKQ managed knowledge-chat integration.
QKQ_EMBEDDED_CHAT_ENABLED=true
QKQ_EMBEDDED_CHAT_SOURCE=qkq
QKQ_EMBEDDED_CHAT_TEMPLATE_CHAT_ID=CHANGE_ME_TEMPLATE_CHAT_ID
QKQ_EMBEDDED_CHAT_IDENTITY_MODE=trusted-header

# Must match the existing active RAGFlow superuser when the admin service starts.
DEFAULT_SUPERUSER_EMAIL=CHANGE_ME_EXISTING_SUPERUSER_EMAIL
